# AutoPost Nexus Environment Configuration
PROJECT_NAME="AutoPost Nexus"
ENVIRONMENT="development"
DEBUG=true

# Database (Default is portable async SQLite)
DATABASE_URL="sqlite+aiosqlite:///./autopost_nexus.db"
DATABASE_ECHO=false

# X / Twitter API v2 Credentials
TWITTER_API_KEY=""
TWITTER_API_SECRET=""
TWITTER_ACCESS_TOKEN=""
TWITTER_ACCESS_SECRET=""

# LinkedIn Posts API Credentials
LINKEDIN_ACCESS_TOKEN=""
LINKEDIN_AUTHOR_URN=""

# Telegram Bot API Credentials
TELEGRAM_BOT_TOKEN=""
TELEGRAM_CHAT_ID=""

# Discord Webhook Credentials
DISCORD_WEBHOOK_URL=""

# Reddit API Credentials
REDDIT_CLIENT_ID=""
REDDIT_CLIENT_SECRET=""
REDDIT_USERNAME=""
REDDIT_PASSWORD=""

# Resilience Configuration
MAX_RETRIES=3
REQUEST_TIMEOUT_SECONDS=10.0
RATE_LIMIT_COOLDOWN_SECONDS=60.0
