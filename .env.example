# ==============================================================================
# Dxora Technologies — Automated Multi-Platform Posting System
# Environment Variable Configuration Template
# ==============================================================================

# Server Runtime Settings
SERVER_HOST=0.0.0.0
SERVER_PORT=4000
DEBUG=false

# 1. Bluesky (AT Protocol) Credentials
# Identifier can be your handle (e.g., alice.bsky.social) or email.
# App Password can be generated under Settings -> App Passwords.
BLUESKY_IDENTIFIER=
BLUESKY_APP_PASSWORD=
BLUESKY_SERVICE_URL=https://bsky.social

# 2. Mastodon (Fediverse) Credentials
# Your Mastodon instance URL and OAuth Access Token (read:accounts write:statuses scope).
MASTODON_INSTANCE_URL=https://mastodon.social
MASTODON_ACCESS_TOKEN=

# 3. DEV.to Credentials
# Generate via Settings -> Extensions -> DEV Community API Keys.
DEVTO_API_KEY=

# 4. WordPress Credentials
# Your WordPress site URL, user login name, and an Application Password
# generated in Users -> Profile -> Application Passwords.
WORDPRESS_SITE_URL=https://example.com
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# 5. Telegram Bot API Credentials
# Bot token created via @BotFather and public or private channel ID (e.g., @mychannel or -1001234567890).
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=
